{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "baseUrl": "."
  },
  "include": ["src/**/*", "index.ts", "seed.ts", "src/types/declaration.d.ts"],
  "noImplicitAny": true,
  "exclude": ["node_modules", "**/*.test.ts"]
}
